#!/usr/bin/env python3
"""Test-only plutil -extract subset for fake Apple Container JSON responses."""
import json
import sys

if len(sys.argv) != 7 or sys.argv[1] != '-extract' or sys.argv[4:] != ['-o', '-', '-']:
    sys.exit('test plutil fixture: unexpected arguments')
path, mode = sys.argv[2], sys.argv[3]
if mode not in ('raw', 'json'):
    sys.exit('test plutil fixture: unsupported format')
obj = json.load(sys.stdin)
for part in path.split('.'):
    obj = obj[int(part)] if isinstance(obj, list) else obj[part]
if mode == 'raw':
    print(obj if isinstance(obj, str) else json.dumps(obj, separators=(',', ':')))
else:
    print(json.dumps(obj, separators=(',', ':')))
