#!/usr/bin/env python3
"""Test-only BSD stat subset that reads actual file owner and mode on any OS."""
import os
import stat
import sys

if len(sys.argv) != 4 or sys.argv[1] != '-f':
    sys.exit('test stat fixture: expected stat -f FORMAT FILE')
info = os.stat(sys.argv[3])
if sys.argv[2] == '%u':
    print(info.st_uid)
elif sys.argv[2] == '%Lp':
    print(format(stat.S_IMODE(info.st_mode), 'o'))
else:
    sys.exit('test stat fixture: unknown format')
